# Supabase (required for cloud mode + guest auth + RLS)
# Create a project at https://supabase.com, run supabase/schema.sql,
# then enable Authentication → Providers → Anonymous sign-ins.

VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_ANON_PUBLIC_KEY

# Without these vars the app runs in local demo mode (localStorage).
